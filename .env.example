# WorkTwin Care Pilot — environment variables

# Backend API / security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ADMIN_TOKEN=
ALLOWED_ORGANISATION_IDS=demo-org

# Admin proxy kill-switch (frontend → backend)
# Set to true only in deployments where the admin UI is intentionally accessible.
# Defaults to disabled so public demo deployments are safe without extra config.
ADMIN_PROXY_ENABLED=false

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=worktwin-documents

# OpenAI
OPENAI_API_KEY=
ANSWER_MODEL=gpt-4o-mini

# Pilot staff context
PILOT_ORGANISATION_ID=demo-org
PILOT_USER_ID=pilot-staff-demo
PILOT_USER_ROLE=Care Worker

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Debug
DEBUG_ENDPOINTS_ENABLED=false
