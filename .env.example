# WorkTwin Care Pilot — environment variables

# Backend API / security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ADMIN_TOKEN=
ALLOWED_ORGANISATION_IDS=demo-org

# Admin proxy kill-switch (frontend → backend)
# Set to true only in deployments where the admin UI is intentionally accessible.
# Defaults to disabled so public demo deployments are safe without extra config.
ADMIN_PROXY_ENABLED=false

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=worktwin-documents
# LEGACY — no longer used. Staff JWT verification is ES256/JWKS only (the backend
# fetches the public JWKS from SUPABASE_URL; see backend/app/jwt_auth.py). The HS256
# fallback that used this secret was removed in 4S.105D. Kept here for reference only;
# setting it has no effect.
SUPABASE_JWT_SECRET=
# Frontend Supabase client credentials (public, safe to expose in browser bundles).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI
OPENAI_API_KEY=
ANSWER_MODEL=gpt-4o-mini

# Pilot staff context
# PILOT_AUTH_MODE controls staff identity on /ask and /policies. Staff routes
# FAIL CLOSED (require a verified token) by default (4S.109B).
#   - Demo mode (static identity below) is used ONLY when this is explicitly set
#     to a recognised demo value: false / 0 / off / no / demo.
#   - Any missing, empty, or mistyped value — and any truthy value such as
#     "true", "1", "yes", "on" — REQUIRES auth (fail closed). There is no silent
#     fall-through to unauthenticated demo behaviour.
# Set it to "false" for the public demo / local dev, or "true" only on a
# controlled pilot deployment after Supabase auth has been fully tested.
PILOT_AUTH_MODE=false
PILOT_ORGANISATION_ID=demo-org
PILOT_USER_ID=pilot-staff-demo
PILOT_USER_ROLE=Care Worker

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to true to expose /admin demo pages in this deployment (off by default for public safety)
NEXT_PUBLIC_ADMIN_DEMO_ENABLED=false
# NEXT_PUBLIC_PILOT_AUTH_MODE controls the frontend staff-route gate (middleware.ts).
# Staff routes FAIL CLOSED (gate ON) by default (4S.109B). The gate is skipped ONLY
# when this is explicitly set to a recognised demo value: false / 0 / off / no / demo.
# Missing / empty / mistyped / "true" all keep the gate ON. Set "false" for the public
# demo / local dev (so demo pages stay open), or "true" only on a controlled pilot
# deployment after auth has been tested.
NEXT_PUBLIC_PILOT_AUTH_MODE=false

# Debug
DEBUG_ENDPOINTS_ENABLED=false
